<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>E-LegalBoom – Document Intake</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #f5f6fa;
      padding: 40px;
    }
    .form-container {
      max-width: 600px;
      margin: auto;
      background: #ffffff;
      padding: 30px;
      border-radius: 8px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }
    label {
      display: block;
      margin-top: 18px;
      font-weight: 600;
    }
    input, select, textarea {
      width: 100%;
      padding: 10px;
      margin-top: 6px;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 15px;
    }
    button {
      margin-top: 28px;
      padding: 12px;
      width: 100%;
      background: #2b6cff;
      color: #fff;
      border: none;
      border-radius: 6px;
      font-size: 16px;
      cursor: pointer;
    }
    button:hover {
      background: #1e54cc;
    }
  </style>
</head>

<body>

  <div class="form-container">
    <h2>Document Intake</h2>

    <form id="intakeForm">
      <label for="customer_name">Full Legal Name</label>
      <input
        type="text"
        id="customer_name"
        name="customer_name"
        placeholder="Enter your full legal name"
        required
      />

      <label for="customer_email">Email</label>
      <input
        type="email"
        id="customer_email"
        name="customer_email"
        required
      />

      <label for="doc_type">Document Type</label>
      <input
        type="text"
        id="doc_type"
        name="doc_type"
        placeholder="e.g. Single-Member LLC"
        required
      />

      <label for="entity_type">Entity Type</label>
      <input
        type="text"
        id="entity_type"
        name="entity_type"
        placeholder="LLC, Trust, Corporation"
      />

      <label for="entity_name">Entity Name</label>
      <input
        type="text"
        id="entity_name"
        name="entity_name"
      />

      <label for="governing_state">Governing State</label>
      <input
        type="text"
        id="governing_state"
        name="governing_state"
        placeholder="CA, TX, FL"
      />

      <button type="submit">Submit Intake</button>
    </form>
  </div>

  <script src="intake.js"></script>
</body>
</html>
